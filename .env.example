# Copy this file to .env and fill in your keys. Never commit .env.

# Flask session secret (any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API key for the AI assistant, summaries and quizzes (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# WhatsApp Business Cloud API (Meta) for weekly PDF reports to parents
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
MONGODB_DB=campusverse
